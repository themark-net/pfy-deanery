# Pinned test image for parallel lanes. No secrets, no repo copy.
# The repo is mounted read-only at run time. Scratch is a tmpfs on /tmp.
# python:3.12-slim is the same minor the ubuntu-24.04 G0 job installs.
# Digest from rootless podman pull on nimo, 2026-11-07.
FROM python:3.12-slim@sha256:05a994d2344eb364cc186910f4fc8786a38215f39f00d0acc25bff33a08f4177

RUN apt-get update \
    && apt-get install -y --no-install-recommends git ripgrep bubblewrap \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
