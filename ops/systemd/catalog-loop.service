# User unit. Does not start from the operator's checkout.
# WorkingDirectory is the home directory.
# ExecStart fetches origin and copies scripts/loop_worktree.sh from origin/main
# into the runtime dir, then runs scripts/catalog_loop.sh in the loop worktree.
# A credential prompt is off. Type=oneshot and Nice=10.
# Set PFY_LOOP_REPO and PFY_OPS_ROOT in %h/.config/pfy/loop.env.
# PFY_OPS_ROOT is the private ops checkout. The needs-mark queue is written and
# committed there, never in the public repo.
[Unit]
Description=One tick of the catalog loop

[Service]
EnvironmentFile=-%h/.config/pfy/loop.env
Type=oneshot
Nice=10
WorkingDirectory=%h
ExecStart=/bin/bash -c 'GIT_DIR=${PFY_LOOP_REPO}/.git GIT_TERMINAL_PROMPT=0 git fetch -q origin && GIT_DIR=${PFY_LOOP_REPO}/.git GIT_TERMINAL_PROMPT=0 git show origin/main:scripts/loop_worktree.sh > %t/pfy-loop-worktree.sh && exec /bin/bash %t/pfy-loop-worktree.sh -- scripts/catalog_loop.sh'
