# User unit. No sudo. Does not start a bot or a model.
# WorkingDirectory is the home directory, not a product checkout.
# Set PFY_LOOP_REPO in %h/.config/pfy/loop.env (the canonical public checkout).
# ExecStart sets GIT_DIR on the main repo and does not cd into that checkout.
# It fetches origin, copies scripts/loop_worktree.sh from origin/main into the
# runtime dir, and runs scripts/catalog_counts_publish.sh from the loop worktree
# (default $PFY_TMP/loop/wt). A credential prompt is off.
# Type=oneshot and Nice=10 stay on this service.
# The timer file is unchanged: 04:17 daily, Persistent=true.
[Unit]
Description=Regenerate catalog counts from stage cards

[Service]
EnvironmentFile=-%h/.config/pfy/loop.env
Type=oneshot
Nice=10
WorkingDirectory=%h
ExecStart=/bin/bash -c 'GIT_DIR=${PFY_LOOP_REPO}/.git GIT_TERMINAL_PROMPT=0 git fetch -q origin && GIT_DIR=${PFY_LOOP_REPO}/.git GIT_TERMINAL_PROMPT=0 git show origin/main:scripts/loop_worktree.sh > %t/pfy-loop-worktree.sh && exec /bin/bash %t/pfy-loop-worktree.sh -- scripts/catalog_counts_publish.sh'
