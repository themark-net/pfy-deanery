diff --git a/examples/x-intake-local/smoke_112_114.py b/examples/x-intake-local/smoke_112_114.py
index cf22508..c30a134 100644
--- a/examples/x-intake-local/smoke_112_114.py
+++ b/examples/x-intake-local/smoke_112_114.py
@@ -46,6 +46,7 @@ import json
 import os
 import re
 import shutil
+import stat
 import subprocess
 import sys
 import tempfile
@@ -109,15 +110,31 @@ def containment(home: str, writable: list[str], bare: str) -> str:
 
 
 def tree_sig(p: Path) -> str | None:
+    """Content, lstat mode, and symlink text. mtime is ignored and links are not followed."""
     if not p.exists():
         return None
     h = hashlib.sha256()
-    for f in sorted(p.rglob("*")):
+    for f in sorted(p.rglob("*", recurse_symlinks=False)):
         try:
-            st = f.stat()
-            h.update(f"{f}:{st.st_size}:{st.st_mtime_ns}".encode())
+            st = f.lstat()
         except OSError:
-            pass
+            h.update(f"{f}:unreadable\n".encode())
+            continue
+        mode = stat.S_IMODE(st.st_mode)
+        try:
+            if stat.S_ISLNK(st.st_mode):
+                h.update(f"{f}:{mode:o}:link:{os.readlink(f)}\n".encode())
+            elif stat.S_ISREG(st.st_mode):
+                fh = hashlib.sha256()
+                with f.open("rb") as fp:  # 1 MiB chunks; a large file stays out of RAM
+                    for chunk in iter(lambda: fp.read(1 << 20), b""):
+                        fh.update(chunk)
+                h.update(f"{f}:{mode:o}:{fh.hexdigest()}\n".encode())
+            else:
+                kind = "dir" if stat.S_ISDIR(st.st_mode) else "other"
+                h.update(f"{f}:{mode:o}:{kind}\n".encode())
+        except OSError:
+            h.update(f"{f}:{mode:o}:unreadable\n".encode())
     return h.hexdigest()
 
 
